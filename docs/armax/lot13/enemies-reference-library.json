    "chr_me1_thresher_maw": {
      "sourceIds": [
        "lot13_me1_steam_886789565",
        "lot13_me1_steam_53915247",
        "lot13_me1_steam_53915246"
      ],
      "referenceReadiness": "plusieurs_captures_natives_complementaires_inspectees; prototype_genere_comparaison_fine_restante",
      "productionNote": "Master du Dévoreur ME1 dans son état émergé, appuyé sur une face entière avec antennes cadrées et deux vues proches complémentaires.",
      "referenceGap": "Corps émergé seulement : base terminée au niveau du sol, corps souterrain non inventé. Lobes cyan, défenses, langue bleue et appendices asymétriques recoupés ; contours de bouche et textures reconstruits à partir de captures. Marges réelles inférieures aux 12 % demandés ; extrémités visibles sans coupe. Franges colorées quasi transparentes observées ; composition sur fonds du jeu encore à contrôler. Échelle en jeu, animations d’émergence, attaques et autres vues non validées."
    },
    "chr_me1_rachni_soldier": {
      "sourceIds": [
        "lot13_me1_steam_1177275257",
        "lot13_me1_steam_1421647124",
        "lot13_me1_steam_275994365"
      ],
      "referenceReadiness": "plusieurs_captures_natives_complementaires_inspectees; prototype_genere_comparaison_fine_restante",
      "productionNote": "Master statique du soldat rachni brun de ME1. Deux vues frontales de Noveria précisent carapace/ventre/appendices ; une vue latérale sombre complète les extrémités des pattes.",
      "referenceGap": "Soldat rachni brun, non Brood Warrior violet, reine ou Ravager. Les grandes antennes sont cadrées dans les références frontales ; les pointes inférieures des pattes sont partiellement masquées dans ces vues et complétées par une vue latérale sombre. Les attaches des appendices, contours fins et microtextures sont reconstruits, sans validation 1:1. Halo semi-transparent visible autour du sujet ; composition alpha à contrôler en jeu. Marges effectives inférieures aux 12 % demandés ; aucune extrémité coupée observée. Dos, autres directions, attaques et animations non produits."
    },
    "chr_me1_varren": {
      "sourceIds": [
        "lot13_me1_steam_580859630",
        "lot13_me1_steam_158236131",
        "lot13_me1_steam_203402317"
      ],
      "referenceReadiness": "plusieurs_captures_natives_complementaires_inspectees; prototype_genere_comparaison_fine_restante",
      "productionNote": "Master du Varren pâle gris/noir de ME1. Face et palette proviennent de la séquence ExoGeni ; corps, queue et pattes sont complétés par deux captures de combat ME1.",
      "referenceGap": "Quatre pattes, tête noire, crête dorsale et marques rosées latérales recoupées avec les trois captures. Les vues complémentaires montrent des animaux couchés ou soulevés par un pouvoir ; leur anatomie est utilisée, leur pose et les effets sont exclus. Nombre précis des petites pointes dorsales, distribution des marques, détails des dents et grain de peau restent à comparer au modèle original. Halo semi-transparent visible autour du sujet ; composition alpha à contrôler en jeu. Marges effectives inférieures aux 12 % demandés ; aucune extrémité coupée observée. Dos, autres directions, poses de morsure et animations non produits."
    }
