  "catalogUpdates": {
    "chr_mea_kett_wraith": {
      "sourceIds": [
        "bioware_mea_character_artdump"
      ],
      "productionNote": "Wraith kett d’Andromeda : une vue complète du modèle texturé équipé publiée par BioWare et attribuée à Furio Tedeschi. Quadrupède sombre, plaque crânienne et épines osseuses claires, longue queue, harnais et brassards verts avec lumières cyan. La planche sans harnais est exclue du guidage. Le dos masqué, l’échelle, les états de camouflage et l’animation restent à comparer au jeu.",
      "referenceReadiness": "planches_primaires_corps_entier_consultees; comparaison_de_production_restante"
    },
    "chr_mea_kett_chosen": {
      "sourceIds": [
        "bioware_mea_character_artdump"
      ],
      "productionNote": "Chosen kett d’Andromeda : quatre vues texturées intégrales de Furio Tedeschi, explicitement nommé dans la publication BioWare. Crâne et bras osseux clairs, col/harnais/guêtres verts, abdomen anthracite et détails cyan, pieds bifides. Pas d’arme sur la planche ; aucun accessoire non documenté ajouté. Pose neutre seulement ; proportions détaillées et animations restent ouvertes.",
      "referenceReadiness": "planches_primaires_corps_entier_consultees; comparaison_de_production_restante"
    },
    "chr_mea_kett_behemoth": {
      "sourceIds": [
        "lowis_mea_behemoth",
        "bioware_mea_character_artdump"
      ],
      "productionNote": "Behemoth kett d’Andromeda, krogan exalté : quatre vues complètes du modèle jeu texturé de Herbert Lowis, maillage gameres par Marco Plouffe. Grandes plaques osseuses crème usées, peau bleu-noir, bosse en carapace, corne centrale, doigts et orteils griffus. La sculpture grise ne remplace pas la palette finale. Aucun lien avec les fichiers de développement Behemoth de Frédéric Daoust qui montrent l’Architecte reliquat déjà couvert.",
      "referenceReadiness": "planches_primaires_corps_entier_consultees; comparaison_de_production_restante"
    },
    "chr_mea_remnant_breacher": {
      "sourceIds": [
        "bioware_mea_character_artdump",
        "makin_mea_models",
        "polygon_mea_breacher_capture",
        "prima_mea_remnant"
      ],
      "productionNote": "Breacher reliquat standard : trois vues complètes du drone de Mathew Makin, carapace grise angulaire, deux pinces sous le corps, ailerons et bandes lumineuses bleu-blanc. Nom recoupé avec une capture du jeu affichant Breacher. La capture sert à l’identification, pas à la palette bleutée de la scène ou au laser rouge. Vol, prises et autres états restent à produire et comparer.",
      "referenceReadiness": "planches_primaires_corps_entier_consultees; comparaison_de_production_restante",
      "referenceIdentification": "Concordance visuelle entre le modèle primaire REM_BRE et une capture de The Remnant Tiller avec Breacher dans le HUD ; le portfolio ne libelle pas le nom de l’unité."
    },
    "chr_mea_remnant_nullifier": {
      "sourceIds": [
        "bioware_mea_character_artdump",
        "makin_mea_models",
        "polygon_mea_nullifier_capture",
        "prima_mea_remnant"
      ],
      "productionNote": "Nullifier reliquat standard : trois angles complets du modèle texturé de Mathew Makin, deux longs appuis latéraux articulés, pods d’épaules, deux panneaux courbes et rubans segmentés pendants. Gris acier/anthracite, émissions blanc-cyan, petits cercles magenta au dos. Le HUD d’une capture de The Journey to Meridian confirme le nom par concordance visuelle. Aucun nom déduit du seul fichier REM_Arch ; pas d’Assembler ou d’Architecte substitué. États ancré/vol, bouclier et animations non validés.",
      "referenceReadiness": "planches_primaires_corps_entier_consultees; comparaison_de_production_restante",
      "referenceIdentification": "Concordance visuelle entre le modèle primaire REM_Arch et une capture du jeu avec Nullifier dans le HUD : pods, appuis et rubans. Le filename ne sert pas à identifier l’ennemi."
    },
    "chr_me2_ymir_mech": {
      "sourceIds": [
        "costa_gdc_me2_creature_pipeline"
      ],
      "productionNote": "YMIR Mech ME2 : deux vues complètes avant/dos du modèle de production présentées par Scylla Costa (BioWare/EA) dans la diapositive ME2 Process, GDC Europe 2011, page 8. L’image embarquée a été extraite sans retouche, distincte du concept voisin. Plaques gris clair, structure noire, deux cercles rouges verticaux de tête, panneaux d’épaules, ronds rouges d’articulations et armes remplaçant les mains. Marquages minuscules, échelle et animations restent à vérifier en jeu ; aucun recours à une reconstitution fan.",
      "referenceReadiness": "planches_primaires_corps_entier_consultees; comparaison_de_production_restante"
    }
  },
